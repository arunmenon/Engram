                        "display_name": "Wrong",
                        "support_event_ids": [source.key],
                    },
                )
            ]
        )
        await graph.upsert_edges(
            [
                EdgeWrite("HAS_PROFILE", NodeRef("Entity", "user:alice", "entity_id"), wrong),
                EdgeWrite("DERIVED_FROM", wrong, source),
            ]
        )
