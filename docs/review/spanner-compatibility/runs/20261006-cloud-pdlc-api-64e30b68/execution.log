s": [], "merge_sha": "66407852d402bc95b5fb15350975e8275089052e", "node_id": "Change:apache/opendal|7386", "node_type": "Change", "number": 7386, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-07-07T11:57:57+00:00", "title": "feat(core): enable presign delete", "updated_at": "2026-07-07T11:57:57+00:00"}, "provenance": {"event_id": "c7bb3764-0401-585a-a92f-406ac57d479f", "global_position": "2026-10-06T11:27:00.381087000Z/000000/c7bb3764-0401-585a-a92f-406ac57d479f", "source": "spanner", "occurred_at": "2026-07-07T20:57:57+09:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-7386"}, "scores": {"decay_score": 0.0, "relevance_score": 2.0, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "direct", "proactive_signal": null}, "Release:apache/opendal|v0.58.1": {"node_id": "Release:apache/opendal|v0.58.1", "node_type": "Release", "attributes": {"breaking": false, "node_id": "Release:apache/opendal|v0.58.1", "node_type": "Release", "ontology_version": "sha256:3a7c761cd2848649", "released_at": "2026-07-28T06:23:41+00:00", "repo": "apache/opendal", "source_trust": "trusted", "updated_at": "2026-07-28T06:23:41+00:00", "version": "v0.58.1"}, "provenance": {"event_id": "92fffbc5-d809-5979-bbb4-db03ca57963f", "global_position": "2026-10-06T11:27:08.758719000Z/000000/92fffbc5-d809-5979-bbb4-db03ca57963f", "source": "spanner", "occurred_at": "2026-07-28T14:23:41+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-release-v0.58.1"}, "scores": {"decay_score": 0.0, "relevance_score": 1.6, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}}, "edges": [{"source": "Release:apache/opendal|v0.58.1", "target": "Change:apache/opendal|7386", "edge_type": "INCLUDES", "properties": {"section": "other", "source_trust": "trusted"}}], "pagination": {"cursor": null, "has_more": false}, "meta": {"query_ms": 643, "nodes_returned": 2, "truncated": false, "inferred_intents": {"trace": 1.0}, "intent_override": null, "seed_nodes": ["Change:apache/opendal|7386"], "seed_strategy": "artifact_seeds", "proactive_nodes_count": 0, "scoring_weights": {"recency": 1.0, "importance": 1.0, "relevance": 1.0}, "retrieval_channels": {}, "capacity": {"max_nodes": 500, "used_nodes": 2, "max_depth": 5}, "eval_pending": []}}}, {"id": "release-of-7869", "f1": 1.0, "found": ["Release:apache/opendal|v0.58.1"], "expected": ["Release:apache/opendal|v0.58.1"], "response": {"nodes": {"Change:apache/opendal|7869": {"node_id": "Change:apache/opendal|7869", "node_type": "Change", "attributes": {"body": "* feat(bindings/python): add from_uri constructor for Operator and AsyncOperator\n\nExpose Operator.from_uri / AsyncOperator.from_uri classmethods backed by\nthe core Operator::from_uri URI registry path, mirroring the Node.js\nbinding. Replace __getnewargs_ex__ with __reduce__ so URI-built operators\npickle via a dedicated reconstructor instead of the scheme-based __new__.\n\n* fix(bindings/python): address review feedback on from_uri\n\n- Extract kwargs via extract_kwargs helper that returns a PyErr instead\n  of panicking on non-str values; apply to from_uri and __new__ for both\n  operator classes.\n- Mirror the async_operator fixture layers and capability overrides in the\n  from_uri test fixture so capability gating and equality assertions match.\n\n* refactor(bindings/python): simplify from_uri pickling and docs per review\n\n- Drop the __from_uri field: reconstruct both scheme- and URI-built\n  operators through a single from_uri-based reconstructor, since the core\n  resolves bare schemes and full URIs through the same path.\n- Reframe from_uri docstrings: options belong in the URI query string\n  (urlencode example); **kwargs documented as override-only.\n\n* docs(bindings/python): debloat from_uri docstrings and reconstructor comments\n\n* docs(bindings/python): use fenced code block in from_uri examples\n\nReplace >>> doctest prompts with a python code block so copying from the\nrendered mkdocs docs does not include the prompt characters.\n\n* refactor(bindings/python): extract kwargs directly and add from_uri round-trip test\n\n- Bind **kwargs to Option<HashMap<String, String>> in the operator\n  constructors, dropping the extract_kwargs helper; PyO3 raises TypeError\n  natively on non-str values.\n- Add sync and async from_uri write/read round-trip tests.", "files": [], "merge_sha": "54b8392b6e2a26a74dc037e8878729aae4d2eb40", "node_id": "Change:apache/opendal|7869", "node_type": "Change", "number": 7869, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-07-07T08:18:45+00:00", "title": "feat(bindings/python): add from_uri constructor for Operator and AsyncOperator", "updated_at": "2026-07-07T08:18:45+00:00"}, "provenance": {"event_id": "f3cdc0bf-92fe-519c-9c76-2a96a0f2d0d6", "global_position": "2026-10-06T11:26:59.566047000Z/000000/f3cdc0bf-92fe-519c-9c76-2a96a0f2d0d6", "source": "spanner", "occurred_at": "2026-07-07T13:48:45+05:30", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-7869"}, "scores": {"decay_score": 0.0, "relevance_score": 2.0, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "direct", "proactive_signal": null}, "Release:apache/opendal|v0.58.1": {"node_id": "Release:apache/opendal|v0.58.1", "node_type": "Release", "attributes": {"breaking": false, "node_id": "Release:apache/opendal|v0.58.1", "node_type": "Release", "ontology_version": "sha256:3a7c761cd2848649", "released_at": "2026-07-28T06:23:41+00:00", "repo": "apache/opendal", "source_trust": "trusted", "updated_at": "2026-07-28T06:23:41+00:00", "version": "v0.58.1"}, "provenance": {"event_id": "92fffbc5-d809-5979-bbb4-db03ca57963f", "global_position": "2026-10-06T11:27:08.758719