: "change-for-gcs-grpc", "f1": 0.33333333333333337, "found": ["Change:apache/opendal|7927", "Change:apache/opendal|7943", "Change:apache/opendal|8153", "Change:apache/opendal|8185", "Change:apache/opendal|8186"], "expected": ["Change:apache/opendal|8153"], "response": {"nodes": {"Change:apache/opendal|8153": {"node_id": "Change:apache/opendal|8153", "node_type": "Change", "attributes": {"body": "* feat(services/gcs-grpc): add GCS gRPC service\n\n* test(services/gcs-grpc): add behavior test\n\n* fix(services/gcs-grpc): preserve routing resource paths\n\n* fix(services/gcs-grpc): route resumable writes by upload ID\n\n* fix(services/gcs-grpc): bind resumable routing to bucket\n\n* chore(services/gcs-grpc): update generated service metadata", "files": [], "merge_sha": "6e921175e553c79a50eaed8e06f0a82f17c4e24a", "node_id": "Change:apache/opendal|8153", "node_type": "Change", "number": 8153, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-08-28T05:44:43+00:00", "title": "feat(services/gcs-grpc): add GCS gRPC service", "updated_at": "2026-08-28T05:44:43+00:00"}, "provenance": {"event_id": "59c39151-feb0-566f-aa87-976d0e64d283", "global_position": "2026-10-06T11:27:29.642655000Z/000000/59c39151-feb0-566f-aa87-976d0e64d283", "source": "spanner", "occurred_at": "2026-08-28T13:44:43+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-8153"}, "scores": {"decay_score": 0.0, "relevance_score": 1.0, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "direct", "proactive_signal": null}, "Change:apache/opendal|8185": {"node_id": "Change:apache/opendal|8185", "node_type": "Change", "attributes": {"body": "", "files": [], "merge_sha": "302805dbb47f680e373bf0c2c1cd7c3586f63f1c", "node_id": "Change:apache/opendal|8185", "node_type": "Change", "number": 8185, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-08-28T06:28:20+00:00", "title": "fix(bindings): enable gcs-grpc service", "updated_at": "2026-08-28T06:28:20+00:00"}, "provenance": {"event_id": "b1bcd7b8-6007-55d8-8fd7-5d88cbfac21d", "global_position": "2026-10-06T11:27:30.164159000Z/000000/b1bcd7b8-6007-55d8-8fd7-5d88cbfac21d", "source": "spanner", "occurred_at": "2026-08-28T14:28:20+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-8185"}, "scores": {"decay_score": 0.0, "relevance_score": 0.848, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "direct", "proactive_signal": null}, "Change:apache/opendal|8186": {"node_id": "Change:apache/opendal|8186", "node_type": "Change", "attributes": {"body": "", "files": [], "merge_sha": "ba9bba03f45bd334161872f9a9275182fed463b6", "node_id": "Change:apache/opendal|8186", "node_type": "Change", "number": 8186, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-08-28T07:22:54+00:00", "title": "fix: update generated gcs-grpc service docs", "updated_at": "2026-08-28T07:22:54+00:00"}, "provenance": {"event_id": "11d427af-33b5-5f75-8fe3-f7d93465b683", "global_position": "2026-10-06T11:27:31.572479000Z/000000/11d427af-33b5-5f75-8fe3-f7d93465b683", "source": "spanner", "occurred_at": "2026-08-28T15:22:54+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-8186"}, "scores": {"decay_score": 0.0, "relevance_score": 0.848, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "direct", "proactive_signal": null}, "Change:apache/opendal|7927": {"node_id": "Change:apache/opendal|7927", "node_type": "Change", "attributes": {"body": "* fix(services/gcs): stop double-encoding object paths in writer\n\nThe writer pre-encoded the path with gcs_percent_encode_path before\ncalling gcs_insert_object_request / gcs_initiate_multipart_upload, which\npercent-encode again. A key like odfs/w/x.parquet was stored under the\nliteral name odfs%2Fw%2Fx.parquet and was unreadable, since the reader\nencodes only once. Forward the raw path so it is encoded exactly once,\nmatching the reader and the other multipart calls.\n\nAdd regression tests asserting the write request single-encodes the path.\n\n* fix(services/gcs): percent-encode path in multipart initiation\n\ngcs_initiate_multipart_upload interpolated the object path into the URL\nwithout percent-encoding, unlike gcs_upload_part / gcs_complete_multipart_upload\n/ gcs_abort_multipart_upload. Once the writer forwards the raw path, object\nnames with characters that must be escaped (spaces, '#', non-ASCII, ...) would\nproduce an invalid or wrong initiation URI. Extract the request builder and\nencode the path once, matching the other multipart calls.\n\nAdd a regression test asserting the initiation URI single-encodes the path.\n\n* refactor(services/gcs): drop encoding-fix helpers per review\n\nAddress review feedback: remove the GcsWriter::insert_object_request\nhelper (inline into write_once), the build_test_core test constructor and\nthe request-builder unit tests that relied on it, and inline the\nmultipart-initiation request builder back into gcs_initiate_multipart_upload.\n\nThe source fixes are unchanged: the writer forwards the raw path and\ngcs_initiate_multipart_upload percent-encodes the path once, matching the\nother multipart helpers.", "files": [], "merge_sha": "19e028238cdc11398099bd25a8ef7895a15d68a7", "node_id": "Change:apache/opendal|7927", "node_type": "Change", "number": 7927, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-07-23T04:11:16+00:00", "title": "fix(services/gcs): stop double-encoding object paths in writer", "updated_at": "2026-07-23T04:11:16+00:00"}, "provenance": {"event_id": "8ddf090c-2eb6-5243-8c30-b34ce88b7bdf", "global_position": "2026-10-06T11:27:05.010575000Z/000000/8ddf090c-2eb6-5243-8c30-b34ce88b7bdf", "source": "spanner", "occurred_at": "2026-07-23T12:11:16+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-7927"}, "scores": {"decay_score": 0.0, "relevance_score": 0.5147, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "direct", "proactive_signal": null}, "Release:apache/opendal|v0.59.0": {"node_id": "Release:apache/opendal|v0.59.0", "node_type": "Release", "attributes": {"breaking": true, "node_id": "Release:apache/opendal|v0.59.0", "node_type": "Release", "ontology_version": "sha256:3a7c761cd2848649", "released_at": "2026-08-31T17:26:45+00:00", "repo": "apache/opendal", "source_trust": "trusted", "updated_at": "2026-08-31T17:26:45+00:00", "version": "v0.59.0"}, "provenance": {"event_id": "6a21de42-c2f1-5da4-b62a-db9a3ab60ea6", "global_position": "2026-10-06T11:27:39.080815000Z/000000/6a21de42-c2f1-5da4-b62a-db9a3ab60ea6", "source": "spanner", "occurred_at": "2026-09-01T01:26:45+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-release-v0.59.0"}, "scores": {"decay_score": 0.0, "relevance_score": 0.2857, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}, "Change:apache/opendal|7943": {"node_id": "Change:apache/opendal|7943", "node_type": "Change", "attributes": {"body": "Revert \"fix(services/gcs): stop double-encoding object paths in writer (#7927)\"\n\nThis reverts commit 19e028238cdc11398099bd25a8ef7895a15d68a7.", "files": [], "merge_sha": "eecfe563ac0302802da067f50e904f7e0121a01d", "node_id": "Change:apache/opendal|7943", "node_type": "Change", "number": 7943, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-07-24T04:33:16+00:00", "title": "Revert \"fix(services/gcs): stop double-encoding object paths