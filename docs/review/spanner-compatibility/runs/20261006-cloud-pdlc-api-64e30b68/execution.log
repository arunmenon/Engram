venance": {"event_id": "8414f485-99f2-5d60-b8c8-d7af9ac95d11", "global_position": "2026-10-06T11:27:12.685919000Z/000000/8414f485-99f2-5d60-b8c8-d7af9ac95d11", "source": "spanner", "occurred_at": "2026-08-07T13:07:54+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-8034"}, "scores": {"decay_score": 0.0, "relevance_score": 0.5714, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}, "Release:apache/opendal|v0.58.2": {"node_id": "Release:apache/opendal|v0.58.2", "node_type": "Release", "attributes": {"breaking": true, "node_id": "Release:apache/opendal|v0.58.2", "node_type": "Release", "ontology_version": "sha256:3a7c761cd2848649", "released_at": "2026-08-17T06:51:09+00:00", "repo": "apache/opendal", "source_trust": "trusted", "updated_at": "2026-08-17T06:51:09+00:00", "version": "v0.58.2"}, "provenance": {"event_id": "c75acfe8-03a9-5189-8e36-06426b6fb3f7", "global_position": "2026-10-06T11:27:18.780751000Z/000000/c75acfe8-03a9-5189-8e36-06426b6fb3f7", "source": "spanner", "occurred_at": "2026-08-17T14:51:09+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-release-v0.58.2"}, "scores": {"decay_score": 0.0, "relevance_score": 0.5714, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}}, "edges": [{"source": "Change:apache/opendal|8034", "target": "Change:apache/opendal|7983", "edge_type": "REVERTS", "properties": {"source_trust": "trusted"}}, {"source": "Release:apache/opendal|v0.58.2", "target": "Change:apache/opendal|7983", "edge_type": "INCLUDES", "properties": {"section": "other", "source_trust": "trusted"}}], "pagination": {"cursor": null, "has_more": false}, "meta": {"query_ms": 1198, "nodes_returned": 3, "truncated": false, "inferred_intents": {}, "intent_override": null, "seed_nodes": ["Change:apache/opendal|7983"], "seed_strategy": "artifact_seeds", "proactive_nodes_count": 0, "scoring_weights": {"recency": 1.0, "importance": 1.0, "relevance": 1.0}, "retrieval_channels": {}, "capacity": {"max_nodes": 500, "used_nodes": 3, "max_depth": 3}, "eval_pending": []}}}, {"id": "reverted-7927", "f1": 1.0, "found": ["Change:apache/opendal|7943"], "expected": ["Change:apache/opendal|7943"], "response": {"nodes": {"Change:apache/opendal|7927": {"node_id": "Change:apache/opendal|7927", "node_type": "Change", "attributes": {"body": "* fix(services/gcs): stop double-encoding object paths in writer\n\nThe writer pre-encoded the path with gcs_percent_encode_path before\ncalling gcs_insert_object_request / gcs_initiate_multipart_upload, which\npercent-encode again. A key like odfs/w/x.parquet was stored under the\nliteral name odfs%2Fw%2Fx.parquet and was unreadable, since the reader\nencodes only once. Forward the raw path so it is encoded exactly once,\nmatching the reader and the other multipart calls.\n\nAdd regression tests asserting the write request single-encodes the path.\n\n* fix(services/gcs): percent-encode path in multipart initiation\n\ngcs_initiate_multipart_upload interpolated the object path into the URL\nwithout percent-encoding, unlike gcs_upload_part / gcs_complete_multipart_upload\n/ gcs_abort_multipart_upload. Once the writer forwards the raw path, object\nnames with characters that must be escaped (spaces, '#', non-ASCII, ...) would\nproduce an invalid or wrong initiation URI. Extract the request builder and\nencode the path once, matching the other multipart calls.\n\nAdd a regression test asserting the initiation URI single-encodes the path.\n\n* refactor(services/gcs): drop encoding-fix helpers per review\n\nAddress review feedback: remove the GcsWriter::insert_object_request\nhelper (inline into write_once), the build_test_core test constructor and\nthe request-builder unit tests that relied on it, and inline the\nmultipart-initiation request builder back into gcs_initiate_multipart_upload.\n\nThe source fixes are unchanged: the writer forwards the raw path and\ngcs_initiate_multipart_upload percent-encodes the path once, matching the\nother multipart helpers.", "files": [], "merge_sha": "19e028238cdc11398099bd25a8ef7895a15d68a7", "node_id": "Change:apache/opendal|7927", "node_type": "Change", "number": 7927, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-07-23T04:11:16+00:00", "title": "fix(services/gcs): stop double-encoding object paths in writer", "updated_at": "2026-07-23T04:11:16+00:00"}, "provenance": {"event_id": "8ddf090c-2eb6-5243-8c30-b34ce88b7bdf", "global_position": "2026-10-06T11:27:05.010575000Z/000000/8ddf090c-2eb6-5243-8c30-b34ce88b7bdf", "source": "spanner", "occurred_at": "2026-07-23T12:11:16+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-7927"}, "scores": {"decay_score": 0.0, "relevance_score": 2.0, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "direct", "proactive_signal": null}, "Change:apache/opendal|7943": {"node_id": "Change:apache/opendal|7943", "node_type": "Change", "attributes": {"body": "Revert \"fix(services/gcs): stop double-encoding object paths in writer (#7927)\"\n\nThis reverts commit 19e028238cdc11398099bd25a8ef7895a15d68a7.", "files": [], "merge_sha": "eecfe563ac0302802da067f50e904f7e0121a01d", "node_id": "Change:apache/opendal|7943", "node_type": "Change", "number": 7943, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-07-24T04:33:16+00:00", "title": "Revert \"fix(services/gcs): stop double-encoding object paths in writer", "updated_at": "2026-07-24T04:33:16+00:00"}, "provenance": {"event_id": "35c63d99-3684-5752-9fe3-bfb5e87a2b54", "global_position": "2026-10-06T11:27:05.368655000Z/000000/35c63d99-3684-5752-9fe3-bfb5e87a2b54", "source": "spanner", "occurred_at": "2026-07-24T12:33:16+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-7943"}, "scores": {"decay_score": 0.0, "relevance_score": 0.5714, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}, "Release:apache/opendal|v0.58.1": {"node_id": "Release:apache/opendal|v0.58.1", "node_type": "Release", "attributes": {"breaking": false, "node_id": "Release:apache/opendal|v0.58.1", "node_type": "Release", "ontology_version": "sha256:3a7c761cd2848649", "released_at": "2026-07-28T06:23:41+00:00", "repo": "apache/opendal", "source_trust": "trusted", "updated_at": "2026-07-28T06:23:41+00:00", "version": "v0.58.1"}, "provenance": {"event_id": "92fffbc5-d809-5979-bbb4-db03ca57963f", "global_position": "2026-10-06T11:27:08.758719000Z/000000/92fffbc5-d809-5979-bbb4-db03ca57963f", "source": "spanner", "occurred_at": "2026-07-28T14:23:41+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-release-v0.58.1"}, "scores": {"decay_score": 0.0, "relevance_score": 0.5714, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}}, "edges": [{"source": "Change:apache/opendal|7943", "target": "Change:apache/opendal|7927", "edge_type": "REVERTS", "properties": {"source_trust": "trusted"}}, {"source": "Release:apache/opendal|v0.58.1", "target": "Change:apache/opendal|7927", "edge_type": "INCLUDES", "properties": {"section": "other", "source_trust": "trusted"}}], "pagination": {"cursor": null, "has_more": false}, "meta": {"query_ms": 614, "nodes_returned": 3, "truncated": false, "inferred_intents": {}, "intent_override": null, "seed_nodes": ["Change:apache/opendal|7927"], "seed_strategy": "artifact_seeds", "proactive_nodes_count": 0, "scoring_weights": {"recency": 1.0, "importance": 1.0, "relevance": 1.0}, "retrieval_channels": {}, "capacity": {"max_nodes": 500, "used_nodes": 3, "max_depth": 3}, "eval_pending": []}}}, {"id": "change-for-s