"2026-10-06T11:27:43.121375000Z/000000/217c8b3d-9183-5407-9a7d-96805fb00140", "source": "spanner", "occurred_at": "2026-09-05T15:28:18+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-release-v0.59.1"}, "scores": {"decay_score": 0.0, "relevance_score": 2.0, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "direct", "proactive_signal": null}, "Change:apache/opendal|8206": {"node_id": "Change:apache/opendal|8206", "node_type": "Change", "attributes": {"body": "Propagate override_content_disposition, override_content_type, and override_cache_control into query parameters (response-content-disposition, response-content-type, response-cache-control) for GCS XML GET and HEAD presigned requests.\n\nCloses #8187.", "files": [], "merge_sha": "670d8f9637ff79fd0a3a2f00cdf751fb3b11f994", "node_id": "Change:apache/opendal|8206", "node_type": "Change", "number": 8206, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-09-01T04:45:12+00:00", "title": "feat(services/gcs): propagate response header overrides into presigned XML requests", "updated_at": "2026-09-01T04:45:12+00:00"}, "provenance": {"event_id": "2d39cff7-6e00-5d51-9831-a83394f6213b", "global_position": "2026-10-06T11:27:39.609359000Z/000000/2d39cff7-6e00-5d51-9831-a83394f6213b", "source": "spanner", "occurred_at": "2026-09-01T12:45:12+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-8206"}, "scores": {"decay_score": 0.0, "relevance_score": 1.6, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}, "Change:apache/opendal|8213": {"node_id": "Change:apache/opendal|8213", "node_type": "Change", "attributes": {"body": "", "files": [], "merge_sha": "767c734788053d26f196797fcefc06defd0ec119", "node_id": "Change:apache/opendal|8213", "node_type": "Change", "number": 8213, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-09-03T07:22:33+00:00", "title": "docs: add conda-forge installation instructions", "updated_at": "2026-09-03T07:22:33+00:00"}, "provenance": {"event_id": "d3c397f2-da02-55ca-9dad-f4f9380709d6", "global_position": "2026-10-06T11:27:40.127695000Z/000000/d3c397f2-da02-55ca-9dad-f4f9380709d6", "source": "spanner", "occurred_at": "2026-09-03T15:22:33+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-8213"}, "scores": {"decay_score": 0.0, "relevance_score": 1.6, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}, "Change:apache/opendal|8214": {"node_id": "Change:apache/opendal|8214", "node_type": "Change", "attributes": {"body": "", "files": [], "merge_sha": "72ef3f673dd4451f0969563b5a2def3f45cf80fb", "node_id": "Change:apache/opendal|8214", "node_type": "Change", "number": 8214, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-09-03T14:16:58+00:00", "title": "fix(ci/goosefs): switch the fixture image to GHCR v2.0.0", "updated_at": "2026-09-03T14:16:58+00:00"}, "provenance": {"event_id": "4e2717b5-4cf9-5608-95eb-018fd43e678a", "global_position": "2026-10-06T11:27:41.126463000Z/000000/4e2717b5-4cf9-5608-95eb-018fd43e678a", "source": "spanner", "occurred_at": "2026-09-03T22:16:58+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-8214"}, "scores": {"decay_score": 0.0, "relevance_score": 1.6, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}, "Change:apache/opendal|8215": {"node_id": "Change:apache/opendal|8215", "node_type": "Change", "attributes": {"body": "", "files": [], "merge_sha": "2403cf8fff2ab52b9fb0f53b42e9157150e45250", "node_id": "Change:apache/opendal|8215", "node_type": "Change", "number": 8215, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-09-03T13:39:19+00:00", "title": "fix(ci): refresh apt index before installing packages", "updated_at": "2026-09-03T13:39:19+00:00"}, "provenance": {"event_id": "b502f899-177c-57b0-ac8b-29233c8569c6", "global_position": "2026-10-06T11:27:40.651743000Z/000000/b502f899-177c-57b0-ac8b-29233c8569c6", "source": "spanner", "occurred_at": "2026-09-03T21:39:19+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-8215"}, "scores": {"decay_score": 0.0, "relevance_score": 1.6, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}, "Change:apache/opendal|8216": {"node_id": "Change:apache/opendal|8216", "node_type": "Change", "attributes": {"body": "`GoosefsBuilder::build()` overlaid `master_addr` on top of the config that\n`from_properties_auto()` had already resolved, so the URI authority of\n`goosefs://host:port/path` (or the `master_addr` option) always won and the\n`goosefs.master.rpc.addresses` / `goosefs.master.hostname` keys of a deployed\n`goosefs-site.properties` never reached the client. A client pointed at a site\nfile that lists the real HA masters still dialed the URI authority and failed\nwith a gRPC transport error.\n\n`build()` now resolves master addresses as `GOOSEFS_MASTER_ADDR` >\n`goosefs-site.properties` > `master_addr`. The site file outranks\n`master_addr` because it carries a deployment's whole HA master list, which a\nsingle URI authority cannot express, and `GOOSEFS_MASTER_ADDR` stays on top as\nthe per-process override. Because `from_properties_auto()` falls back to the\nSDK default `127.0.0.1:9200`, the builder now asks which source actually\ndeclared an address instead of reading the loaded value.\n\nUser-facing impact: a site file or `GOOSEFS_MASTER_ADDR` now supersedes the URI\nauthority and the `master_addr` option, and `build()` fails with\n`ConfigInvalid` when no source supplies an address instead of silently dialing\n`127.0.0.1:9200`.\n\nBump goosefs-sdk to 0.1.9 for RUSTSEC-2026-0002 (`lru` >= 0.16.3) and master\nconnection pooling. 0.1.9 does not yet honor `$GOOSEFS_CONF_DIR`;\n`$GOOSEFS_CONFIG_FILE` remains the way to point at a file outside the searched\ndirectories. Regenerated Java, .NET, and website docs for the new\n`master_addr` precedence.", "files": [], "merge_sha": "54b33a16284da7c781824474cc1555e5ee379a51", "node_id": "Change:apache/opendal|8216", "node_type": "Change", "number": 8216, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-09-04T07:43:28+00:00", "title": "fix(services/goosefs): resolve master addresses from goosefs-site.properties", "updated_at": "2026-09-04T07:43:28+00:00"}, "provenance": {"event_id": "999e6bf3-ae53-5696-aad9-b3790e8ee318", "global_position": "2026-10-06T11:27:41.682591000Z/000000/999e6bf3-ae53-5696-aad9-b3790e8ee318", "source": "spanner", "occurred_at": "2026-09-04T15:43:28+08:00", "session_id": "pdlc:apache/opendal", "agent_id": "webhook:github", "trace_id": "opendal-pr-8216"}, "scores": {"decay_score": 0.0, "relevance_score": 1.6, "importance_score": 0, "ppr_score": 0.0}, "retrieval_reason": "proactive", "proactive_signal": null}, "Change:apache/opendal|8223": {"node_id": "Change:apache/opendal|8223", "node_type": "Change", "attributes": {"body": "", "files": [], "merge_sha": "8fcab844af9ad4b8ad91e6de58ea7fbeb051eba2", "node_id": "Change:apache/opendal|8223", "node_type": "Change", "number": 8223, "ontology_version": "sha256:3a7c761cd2848649", "repo": "apache/opendal", "source_trust": "trusted", "status": "merged", "status_changed_at": "2026-09-04T14:59:27+00:00", "title": "fix(core): include changelog in opendal-core package", "updated_at": "2026-09-04T14:59:27+00